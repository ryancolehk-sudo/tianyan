          }
        },
        "required": [
          "id",
          "username",
          "role"
        ],
        "additionalProperties": false
      },
      "Session": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "csrf_token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "user",
          "csrf_token"
        ],
        "additionalProperties": false
      },
      "LoginInput": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-zA-Z0-9_.-]+$"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "required": [
          "username",
          "password"
        ],
        "additionalProperties": false
      },
      "Rights": {
        "type": "object",
        "properties": {
          "display": {
            "type": "string",
            "enum": [
              "allowed",
              "denied",
              "unknown"
            ]
          },
          "cache": {
            "type": "string",
            "enum": [
              "allowed",
              "denied",
              "unknown"
            ]
          },
          "export": {
            "type": "string",
            "enum": [
              "allowed",
              "denied",
              "unknown"
            ]
          },
          "redistribute": {
            "type": "string",
            "enum": [
              "allowed",
              "denied",
              "unknown"
            ]
          }
        },
        "required": [
          "display",
          "cache",
          "export",
          "redistribute"
        ],
        "additionalProperties": false
      },
      "Provider": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "kind": {
            "type": "string",
            "enum": [
              "manual",
              "market",
              "news",
              "calendar",
              "model"
            ]
          },
          "adapter_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "configured": {
            "type": "boolean"
          },
          "enabled": {
            "type": "boolean"
          },
          "entitlement_status": {
            "type": "string",
            "enum": [
              "verified",
              "denied",
              "unknown"
            ]
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "minItems": 0
          },
          "rights": {
            "$ref": "#/components/schemas/Rights"
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "adapter_version",
          "configured",
          "enabled",
          "entitlement_status",
          "capabilities",
          "rights"
        ],
        "additionalProperties": false
      },
      "Instrument": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "exchange": {
            "type": "string",
            "enum": [
              "SSE",
              "SZSE",
              "BSE"
            ]
          },
          "symbol": {
            "type": "string",
            "pattern": "^[0-9]{6}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "valid_from": {
            "type": "string",
            "format": "date"
          },
          "valid_to": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "exchange",
          "symbol",
          "name",
          "valid_from",
          "valid_to"
        ],
        "additionalProperties": false
      },
      "ResultRef": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "snapshot",
              "rule_run",
              "ai_interpretation"
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "type",
          "id"
        ],
        "additionalProperties": false
      },
      "Job": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string",
            "enum": [
              "snapshot.create",
              "rule.run",
              "ai.explain",
              "system.check"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed",
              "cancelled"
            ]
          },
          "attempts": {
            "type": "integer",
            "minimum": 0
          },
          "result_ref": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ResultRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "(Z|[+-]\\d{2}:\\d{2})$"
          },
          "completed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "(Z|[+-]\\d{2}:\\d{2})$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "state",
          "attempts",
          "result_ref",
          "error_code",
          "created_at",
          "completed_at"
        ],
        "additionalProperties": false
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ]
          },
