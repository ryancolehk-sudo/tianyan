# Configuration reference only. Never commit populated secrets.
# First installation: python scripts/project.py init generates private .env passwords.
# Existing installation: preserve its .env and credentials; do not initialize it again.
# All supplier/model credentials are optional and server-only. Never use VITE_* for them.

# Required: unique Compose installation name; use demo for disposable tests.
COMPOSE_PROJECT_NAME=jlpm-demo
# Required: server-controlled installation mode, real or demo; clients cannot switch it.
JL_APP_MODE=demo
# Required: browser origin used for same-origin/CSRF validation.
JL_PUBLIC_ORIGIN=http://127.0.0.1:8088
# Optional locally; required true with HTTPS for any remote origin.
JL_COOKIE_SECURE=false
# Optional: bind address. Local-only by default; remote exposure needs deployment review.
WEB_BIND=127.0.0.1
# Optional: local web port; choose a free port for a new test installation.
WEB_PORT=8088
# Required: independent database administrator password; generated by init.
DB_ADMIN_PASSWORD=
# Required: independent schema migration role password; generated by init.
DB_MIGRATE_PASSWORD=
# Required: independent application role password; generated by init.
DB_APP_PASSWORD=
# Required: independent maintenance role password; generated by init.
DB_MAINTENANCE_PASSWORD=
# Required for a recorded build: exact candidate commit, not a secret.
JL_BUILD_REVISION=
# Optional: enable the existing derived read cache.
JL_READ_CACHE_ENABLED=true
# Optional: collection is off until an explicitly authorized source is configured.
JL_DATA_COLLECTION_ENABLED=false
# Optional: enable the existing maintenance control plane; not permission to update.
JL_MAINTENANCE_ENABLED=true
# Optional update feed; leave empty when unconfigured. Never put credentials in URLs.
JL_UPDATE_FEED_URL=
# Required only with a configured feed: public Ed25519 verification key, never its private key.
JL_UPDATE_PUBLIC_KEY=
# Required only with a configured feed: explicit permitted download hosts.
JL_UPDATE_ALLOWED_HOSTS=[]
# Optional installation type: source or managed. Does not grant update permission.
JL_UPDATE_INSTALLATION=source
# Optional: private backup host directory; generated contents never enter Git.
JL_BACKUP_HOST_DIRECTORY=./backups
# Optional: local downloaded update artifacts directory.
JL_UPDATE_HOST_DIRECTORY=./updates
# Optional: maintenance status files for this installation.
JL_MAINTENANCE_STATUS_DIRECTORY=./maintenance-status
# Required for Compose: distinct cookie name generated by init; not a session value.
JL_SESSION_COOKIE=jlpm-demo_session
# Optional: TickFlow server credential; keep empty when unused.
JL_TICKFLOW_API_KEY=
# Optional: Mairui server licence; use and redistribution rights require separate verification.
JL_MAIRUI_LICENCE=
# Optional: private Tushare credential; points/access do not grant data redistribution rights.
JL_TUSHARE_TOKEN=
# Optional: the official HTTPS service or a public HTTPS endpoint selected by this installation.
JL_TUSHARE_ENDPOINT=https://api.tushare.pro/
# Optional legacy model settings; prefer the data-center encrypted connection service.
# No model request is authorized merely by filling these fields.
# Optional: disabled by default; enabling also requires an explicit source allowlist.
JL_MODEL_ENABLED=false
# Optional: local model connection identifier, not a credential.
JL_MODEL_CONNECTION_ID=news-default
# Required only for that model connection: approved API origin without embedded credentials.
JL_MODEL_BASE_URL=
# Required only for that model connection: provider model identifier.
JL_MODEL_NAME=
# Optional: server-side environment variable name holding the model credential.
JL_MODEL_CREDENTIAL_REF=JL_MODEL_API_KEY
# Required only for that model connection: private model API key, never returned by config reads.
JL_MODEL_API_KEY=
# Optional: bounded model timeout in seconds.
JL_MODEL_TIMEOUT_SECONDS=30
# Optional: request structured model output.
JL_MODEL_JSON_MODE=true
# Optional: non-secret additional model options; never place credentials here.
JL_MODEL_EXTRA_JSON={}
# Optional: explicit allowed news/source families; empty authorizes none.
JL_NEWS_AI_ALLOWED_FAMILIES=
